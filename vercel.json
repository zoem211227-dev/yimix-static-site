{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "redirects": [
    { "source": "/oem-odm.html", "destination": "/blog/oem-odm.html", "permanent": true },
    { "source": "/blog/products.html", "destination": "/products.html", "permanent": true },
    { "source": "/blog/massage-chair-buying-guide.html", "destination": "/massage-chair-buying-guide.html", "permanent": true },
    { "source": "/blog/massage-chair-faq.html", "destination": "/massage-chair-faq.html", "permanent": true },
    { "source": "/product.html", "destination": "/products.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/optimized/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/icons/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/downloads/yimix-product-list.csv",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/csv; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"YIMIX-product-list.csv\""
        }
      ]
    }
  ]
}
